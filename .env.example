# SankalpVani Environment Variables Template
# Copy this file to .env.local and fill in the values for development

# Database Configuration (PostgreSQL system of record)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sankalpvani_dev"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sankalpvani_dev"

# Authentication Provider (Supabase Auth / NextAuth / Custom Adapter)
AUTH_PROVIDER_URL="https://your-project.supabase.co"
AUTH_PROVIDER_ANON_KEY="your-anon-key"
AUTH_PROVIDER_SERVICE_KEY="your-service-role-key"

# Storage Configuration (S3 / Supabase Storage for Temple assets & docs)
STORAGE_ENDPOINT="https://your-storage-endpoint"
STORAGE_BUCKET="sankalpvani-assets"

# Cache & Performance (Redis-compatible, optional initially)
REDIS_URL="redis://localhost:6379"

# Application Base
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="generate-a-secure-random-32-byte-secret"
ENCRYPTION_KEY="generate-a-secure-random-32-byte-key"

# External Notification & Payment Adapters
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_KEY=""
PAYMENT_PROVIDER_SECRET=""

# Operational Logging
LOG_LEVEL="info"

